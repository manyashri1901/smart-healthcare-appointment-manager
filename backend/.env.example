# Copy to backend/.env and fill in real values.
# Every var below is what backend/app/config.py actually reads — nothing more.

# --- Core --------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# Origins allowed to call the API. This is what actually controls CORS
# (server.py's CORSMiddleware reads it directly) — comma-separated, no
# spaces, e.g. "http://localhost:3000,https://app.example.com".
CORS_ORIGINS=http://localhost:3000

# Informational only in this app's own code — no route or middleware
# currently reads it. Kept for scripts/infra that want to know the
# backend's own public URL.
BACKEND_URL=http://localhost:8001

# --- Database (required) ------------------------------------------------
# PostgreSQL only — the app fails fast at startup if this is unset.
DATABASE_URL=postgresql://user:password@localhost:5432/smartcare

# --- LLM (optional — pre/post-visit AI summaries degrade gracefully) ---
# LLM_PROVIDER: anthropic | openai | emergent | leave blank to disable
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5
# Only needed for OpenAI-compatible endpoints other than api.openai.com
# (e.g. Groq, another OpenAI-compatible gateway).
LLM_BASE_URL=

# --- Email (optional — SMTP; Mailtrap works well for local dev) --------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@smartcare.example.com

# --- Tuning (optional — defaults shown) ---------------------------------
# Minutes a booking slot hold is reserved before it expires.
SLOT_HOLD_MINUTES=5
# Minutes a notified waitlist entry has to claim a freed slot.
WAITLIST_CLAIM_MINUTES=10
# Max retry attempts for a failed outbound notification email.
NOTIFICATION_MAX_RETRIES=3
